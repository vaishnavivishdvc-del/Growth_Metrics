# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Mixpanel ──────────────────────────────────────────────────────────────────
# Service Account → mixpanel.com → Settings → Service Accounts → Create
MX_PROJECT_ID=2823261
MX_SA_USERNAME=your_service_account_username.12345.mp-service-account
MX_SA_SECRET=your_service_account_secret

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Generate App Password: myaccount.google.com → Security → 2-Step → App Passwords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_TO=recipient1@example.com,recipient2@example.com
GMAIL_CC=

# ── Google Chat ───────────────────────────────────────────────────────────────
# In Google Chat: Space → Manage webhooks → Add webhook → copy URL
GCHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=YYYY&token=ZZZZ
